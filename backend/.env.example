# ===========================================================================
# Finspect Backend — Environment Configuration
# ===========================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ===========================================================================

# --- Server ----------------------------------------------------------------
PORT=5000
NODE_ENV=development             # "development" or "production"
FRONTEND_URL=http://localhost:5173  # Comma-separated for multiple origins

# --- Authentication Mode ---------------------------------------------------
# true  → Use in-memory dummy data (for local dev/testing, no DB required)
# false → Use PostgreSQL database (required for production)
USE_DUMMY_AUTH=false

# --- Database (PostgreSQL) -------------------------------------------------
# Required when USE_DUMMY_AUTH=false
DATABASE_URL=postgresql://neondb_owner:npg_5XqDZentJa0M@ep-steep-scene-aolw6fxl-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require


# --- JWT (JSON Web Tokens) -------------------------------------------------
# Use a long, random string. In production, generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d                # Token lifetime (e.g., 1d, 7d, 24h)

# --- Credential Vault Encryption -------------------------------------------
# AES-256-GCM key for encrypting stored credentials/passwords.
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIAL_SECRET=replace-with-32-byte-secret

# --- Google Calendar Integration (OAuth 2.0) -------------------------------
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add the redirect URI below to the "Authorized redirect URIs"
# 4. Copy the Client ID and Client Secret here
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# IMPORTANT: Must match exactly what's registered in Google Cloud Console.
# For local dev:  http://localhost:5000/api/auth/google/callback
# For production: https://yourdomain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Email (SMTP) ----------------------------------------------------------
# Used for sending task reminders, compliance reminders, etc.
# Gmail example (requires App Password): https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                     # 587 for TLS, 465 for SSL
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Finspect <no-reply@finspect.com>

# --- WhatsApp / Twilio (optional) ------------------------------------------
# Used for task assignment notifications via WhatsApp.
# Leave empty to skip WhatsApp notifications.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio sandbox number
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX     # Recipient number

# --- Seed Data (optional, for prisma seed) ---------------------------------
# Default admin account created by `npm run prisma:seed`
SEED_ADMIN_NAME=Finspect Admin
SEED_ADMIN_EMAIL=admin@finspect.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ===========================================================================
# Production Checklist
# ===========================================================================
# Before deploying to production, ensure the following:
#
#  [ ] USE_DUMMY_AUTH=false        — Disable dummy data mode
#  [ ] DATABASE_URL                — Set to production PostgreSQL URL
#  [ ] JWT_SECRET                  — Strong random secret (64+ hex chars)
#  [ ] CREDENTIAL_SECRET           — Strong random secret (32+ hex chars)
#  [ ] GOOGLE_CLIENT_ID            — From Google Cloud Console
#  [ ] GOOGLE_CLIENT_SECRET        — From Google Cloud Console
#  [ ] GOOGLE_REDIRECT_URI         — Set to production callback URL
#  [ ] FRONTEND_URL                — Set to your deployed frontend URL
#  [ ] SMTP_*                      — Configured for sending emails
#  [ ] NODE_ENV=production         — Enables production optimizations
#
# Google Calendar Additional Setup:
#  [ ] Google Cloud Console → APIs & Services → Enable Google Calendar API
#  [ ] OAuth consent screen → Add test users or set to "Production"
#  [ ] Add GOOGLE_REDIRECT_URI to authorized redirect URIs
#  [ ] Scopes: https://www.googleapis.com/auth/calendar
#              https://www.googleapis.com/auth/calendar.events
#              https://www.googleapis.com/auth/userinfo.email
# ===========================================================================
