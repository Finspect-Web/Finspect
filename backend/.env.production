# ===========================================================================
# Finspect Backend — Production Environment Template
# ===========================================================================
# Copy the values from this file into your Render Dashboard → Environment
# Variables. DO NOT commit this file with real secrets to git.
#
# Quick-start secrets (run in terminal):
#   JWT_SECRET:       node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   CREDENTIAL_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ===========================================================================

# --- Server ----------------------------------------------------------------
NODE_ENV=production
PORT=10000
# For production: your deployed Vercel URL (comma-separated if multiple)
FRONTEND_URL=https://finspect.vercel.app

# --- Authentication Mode ---------------------------------------------------
# Must be "false" for production — uses PostgreSQL from DATABASE_URL
USE_DUMMY_AUTH=false

# --- Database (Neon PostgreSQL) --------------------------------------------
# From Neon Dashboard → Connect → Prisma
# Must include ?sslmode=require for Neon
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- JWT --------------------------------------------------------------------
JWT_SECRET=replace-with-64-char-hex-string
JWT_EXPIRES_IN=1d

# --- Credential Vault Encryption -------------------------------------------
# AES-256-GCM key for encrypting stored credentials. Must be 32+ bytes hex.
CREDENTIAL_SECRET=replace-with-64-char-hex-string

# --- Google Calendar Integration (OAuth 2.0) --------------------------------
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://finspect-api.onrender.com/api/auth/google/callback

# --- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=Finspect <no-reply@finspect.com>

# --- Twilio WhatsApp (optional) ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# --- Seed Data (optional, for npx prisma db seed) ---------------------------
SEED_ADMIN_NAME=Finspect Admin
SEED_ADMIN_EMAIL=admin@finspect.com
SEED_ADMIN_PASSWORD=ChangeMe123!
