generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum ComplianceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum RecurrenceType {
  NONE
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum DocumentCategory {
  KYC
  TAX
  LEGAL
  FINANCIAL
  COMPLIANCE
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

enum ActivityAction {
  TASK_CREATED
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_UPDATED
  TASK_DELETED
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_DELETED
  CREDENTIAL_CREATED
  CREDENTIAL_UPDATED
  CREDENTIAL_DELETED
  USER_CREATED
  INVOICE_CREATED
  INVOICE_UPDATED
  INVOICE_DELETED
  PAYMENT_RECORDED
  COMPLIANCE_CREATED
  COMPLIANCE_UPDATED
  COMPLIANCE_COMPLETED
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  TICKET_CREATED
  TICKET_UPDATED
  TICKET_RESOLVED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  LEAVE
}

model User {
  id                      String           @id @default(uuid()) @db.Uuid
  name                    String
  email                   String           @unique
  password                String
  role                    Role             @default(STAFF)
  createdAt               DateTime         @default(now())
  createdClients          Client[]         @relation("ClientCreatedBy")
  assignedTasks           Task[]           @relation("TaskAssignedTo")
  delegatedTasks          Task[]           @relation("TaskAssignedBy")
  createdInvoices         Invoice[]        @relation("InvoiceCreatedBy")
  createdPayments         Payment[]        @relation("PaymentCreatedBy")
  assignedComplianceItems ComplianceItem[] @relation("ComplianceAssignedTo")
  createdComplianceItems  ComplianceItem[] @relation("ComplianceCreatedBy")
  uploadedDocuments       Document[]       @relation("DocumentUploadedBy")
  createdTickets          Ticket[]         @relation("TicketCreatedBy")
  assignedTickets         Ticket[]         @relation("TicketAssignedTo")
  activityLogs            ActivityLog[]    @relation("ActivityByUser")
  createdWorkflowInstances WorkflowInstance[] @relation("WorkflowInstanceCreatedBy")
  attendances             Attendance[]
  timesheetEntries        TimesheetEntry[]
}

model Client {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  email       String
  phone       String
  companyName String
  gstin       String?
  pan         String?
  address     String
  notes       String?
  createdById String           @db.Uuid
  createdBy   User             @relation("ClientCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]
  credentials Credential[]
  invoices    Invoice[]
  compliances ComplianceItem[]
  documents   Document[]
  tickets     Ticket[]
  workflowInstances WorkflowInstance[]
  timesheetEntries  TimesheetEntry[]
  createdAt   DateTime         @default(now())

  @@index([createdById])
}

model Task {
  id                String            @id @default(uuid()) @db.Uuid
  title             String
  description       String?
  assignedToId      String            @db.Uuid
  assignedById      String            @db.Uuid
  clientId          String            @db.Uuid
  dueDate           DateTime
  priority          Priority          @default(MEDIUM)
  status            TaskStatus        @default(PENDING)
  reminderSentAt    DateTime?
  workflowStepId    String?           @db.Uuid
  complianceTypeId  String?           @db.Uuid
  workflowInstanceId String?          @db.Uuid
  stageId           String?           @db.Uuid
  createdAt         DateTime          @default(now())
  assignedTo        User              @relation("TaskAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy        User              @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  client            Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  workflowStep      WorkflowStep?     @relation(fields: [workflowStepId], references: [id], onDelete: SetNull)
  complianceType    ComplianceType?   @relation(fields: [complianceTypeId], references: [id], onDelete: SetNull)
  workflowInstance  WorkflowInstance? @relation(fields: [workflowInstanceId], references: [id], onDelete: SetNull)
  stage             TaskStage?        @relation(fields: [stageId], references: [id], onDelete: SetNull)
  timesheetEntries  TimesheetEntry[]

  @@index([assignedToId])
  @@index([clientId])
  @@index([status, dueDate])
  @@index([workflowStepId])
  @@index([complianceTypeId])
  @@index([workflowInstanceId])
  @@index([stageId])
}

model TaskStage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  order     Int
  color     String   @default("#4c2ca7")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@unique([name])
  @@unique([order])
}

model Credential {
  id          String   @id @default(uuid()) @db.Uuid
  clientId    String   @db.Uuid
  serviceName String
  username    String
  password    String
  notes       String?
  createdAt   DateTime @default(now())
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ActivityLog {
  id            String         @id @default(uuid()) @db.Uuid
  action        ActivityAction
  performedById String         @db.Uuid
  referenceId   String
  createdAt     DateTime       @default(now())
  performedBy   User           @relation("ActivityByUser", fields: [performedById], references: [id], onDelete: Restrict)

  @@index([performedById, createdAt])
  @@index([referenceId])
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  clientId       String        @db.Uuid
  invoiceNumber  String        @unique
  issueDate      DateTime
  dueDate        DateTime
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  status         InvoiceStatus @default(DRAFT)
  notes          String?
  createdById    String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  payments       Payment[]

  @@index([clientId])
  @@index([status, dueDate])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  paymentDate DateTime
  method      PaymentMethod
  reference   String?
  notes       String?
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  invoice     Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy   User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([invoiceId, paymentDate])
}

model ComplianceItem {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @db.Uuid
  title        String
  description  String?
  type         String           @default("OTHER")
  dueDate      DateTime
  recurrence   RecurrenceType   @default(NONE)
  status       ComplianceStatus @default(PENDING)
  assignedToId String           @db.Uuid
  createdById  String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo   User             @relation("ComplianceAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)
  createdBy    User             @relation("ComplianceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([clientId, dueDate])
  @@index([assignedToId, status])
}

model ComplianceType {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @unique
  description       String?
  createdAt         DateTime           @default(now())
  workflowTemplates WorkflowTemplate[]
  tasks             Task[]
  workflowInstances WorkflowInstance[]
}

model WorkflowTemplate {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  complianceTypeId String            @db.Uuid @unique
  createdAt        DateTime          @default(now())
  complianceType   ComplianceType    @relation(fields: [complianceTypeId], references: [id], onDelete: Restrict)
  steps            WorkflowStep[]
  workflowInstances WorkflowInstance[]

  @@index([complianceTypeId])
}

model WorkflowStep {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  order       Int
  defaultRole Role
  daysOffset  Int              @default(0)
  workflowId  String           @db.Uuid
  createdAt   DateTime         @default(now())
  workflow    WorkflowTemplate @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@unique([workflowId, order])
  @@index([workflowId, order])
}

model WorkflowInstance {
  id                String           @id @default(uuid()) @db.Uuid
  clientId          String           @db.Uuid
  complianceTypeId  String           @db.Uuid
  workflowTemplateId String          @db.Uuid
  dueDate           DateTime
  createdById       String           @db.Uuid
  createdAt         DateTime         @default(now())
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  complianceType    ComplianceType   @relation(fields: [complianceTypeId], references: [id], onDelete: Restrict)
  workflowTemplate  WorkflowTemplate @relation(fields: [workflowTemplateId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("WorkflowInstanceCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  tasks             Task[]

  @@index([clientId, dueDate])
  @@index([workflowTemplateId])
}

model Document {
  id           String           @id @default(uuid()) @db.Uuid
  clientId     String           @db.Uuid
  title        String
  category     DocumentCategory @default(OTHER)
  fileUrl      String
  description  String?
  expiresAt    DateTime?
  uploadedById String           @db.Uuid
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy   User             @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([clientId, category])
}

model Ticket {
  id           String       @id @default(uuid()) @db.Uuid
  clientId     String       @db.Uuid
  subject      String
  description  String
  priority     TicketPriority @default(MEDIUM)
  status       TicketStatus @default(OPEN)
  createdById  String       @db.Uuid
  assignedToId String?      @db.Uuid
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo   User?        @relation("TicketAssignedTo", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([clientId, status])
  @@index([assignedToId])
}

model Attendance {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  date       DateTime
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     AttendanceStatus @default(PRESENT)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  user       User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@index([date, status])
  @@index([userId, date])
}

model TimesheetEntry {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  clientId        String?  @db.Uuid
  taskId          String?  @db.Uuid
  workDate        DateTime
  durationMinutes Int
  description     String
  billable        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  client          Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, workDate])
  @@index([clientId, workDate])
  @@index([taskId, workDate])
}
